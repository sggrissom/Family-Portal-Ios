<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The one place the widgets read from: the app publishes a snapshot and
	     its images into this group's container. No keychain group, no
	     network: a widget never holds a session of its own. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.familyrecord.ios</string>
	</array>
</dict>
</plist>
